@{
    Layout = null;
    ViewBag.Title = "Login";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <title>Login | Consultório Quality</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- FontAwesome -->
    <link href="~/Content/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800&display=swap"
          rel="stylesheet">

    <!-- SB Admin 2 -->
    <link href="~/Content/css/sb-admin-2.min.css" rel="stylesheet" />
</head>

<body class="bg-gradient-primary d-flex align-items-center justify-content-center vh-100">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-4 col-lg-5 col-md-6 col-sm-8">

                <div class="card shadow-lg border-0 rounded-lg">

                    <div class="card-header bg-primary text-white text-center py-4">
                        <h4 class="mb-0 font-weight-bold">
                            <i class="fas fa-clinic-medical"></i> Consultório Quality
                        </h4>
                        <small>Gestão de Consultas Médicas</small>
                    </div>

                    <div class="card-body p-4">

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger text-center">
                                @ViewBag.Error
                            </div>
                        }

                        <form method="post">

                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label>Email</label>
                                <input type="email"
                                       name="Email"
                                       class="form-control form-control-user"
                                       placeholder="exemplo@email.com"
                                       required />
                            </div>

                            <div class="form-group">
                                <label>Senha</label>
                                <input type="password"
                                       name="Senha"
                                       class="form-control form-control-user"
                                       placeholder="Digite a senha"
                                       required />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-user btn-block mt-3">
                                <i class="fas fa-sign-in-alt"></i> Entrar
                            </button>

                        </form>

                    </div>

                    <div class="card-footer text-center bg-light small">
                        © @DateTime.Now.Year · Direitos Reservados
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- JS -->
    <script src="~/Content/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/js/sb-admin-2.min.js"></script>

</body>
</html>
