@model MGMC.Models.Consulta

@{
    ViewBag.Title = "Marcar Consulta";
}

<h4 class="text-center mt-2 font-weight-bold">
    <i class="fa fa-calendar-check"></i> MARCAÇÃO DE CONSULTA
</h4>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@using (Html.BeginForm("Create", "Consultas", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="row">

        <!-- Paciente -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.PacienteId, "Paciente")
                @Html.DropDownListFor(m => m.PacienteId,
                    ViewBag.Pacientes as SelectList,
                    "-- Selecione o Paciente --",
                    new { @class = "form-control", required = "required" })
            </div>
        </div>

        <!-- Médico -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.MedicoId, "Médico")
                @Html.DropDownListFor(m => m.MedicoId,
                    ViewBag.Medicos as SelectList,
                    "-- Selecione o Médico --",
                    new { @class = "form-control", required = "required" })
            </div>
        </div>

        <!-- Data -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.DataConsulta, "Data da Consulta")
                @Html.TextBoxFor(m => m.DataConsulta,
                    "{0:yyyy-MM-dd}",
                    new { @class = "form-control", type = "date", required = "required" })
            </div>
        </div>

        <!-- Hora -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.HoraConsulta, "Hora da Consulta")
                @Html.TextBoxFor(m => m.HoraConsulta,
                    new { @class = "form-control", type = "time", required = "required" })
            </div>
        </div>

    </div>

    <div class="mt-4 text-right">
        <a href="@Url.Action("Index", "Consultas")" class="btn btn-warning">
            <i class="fa fa-times-circle"></i> Cancelar
        </a>

        <button type="submit" class="btn btn-primary ml-2">
            <i class="fa fa-save"></i> Marcar Consulta
        </button>
    </div>
}
