@model MGMC.Models.Paciente

<h4>Editar Paciente</h4>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.DataNascimento)

    <div class="form-group">
        @Html.LabelFor(m => m.Nome)
        @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Genero)
        @Html.DropDownListFor(m => m.Genero,
            new SelectList(
                new[] { "Masculino", "Feminino" },
                Model.Genero
            ),
            "-- Selecione --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Telefone)
        @Html.TextBoxFor(m => m.Telefone, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
    </div>

    <br />
    <button type="submit" class="btn btn-primary">
        <i class="fa fa-save"></i> Salvar
    </button>
}
