@model MGMC.Models.Paciente

@{
    ViewBag.Title = "Cadastro de Pacientes";
}

<h4 class="text-center mt-2 font-weight-bold">
    <i class="fa fa-user-injured"></i> CADASTRO DE PACIENTE
</h4>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle"></i> @TempData["success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@using (Html.BeginForm("Create", "Pacientes", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="row">

        <!-- Nome -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.Nome, "Nome Completo")
            @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", placeholder = "Nome completo do paciente", required = "required" })
        </div>

        <!-- Data de Nascimento -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.DataNascimento, "Data de Nascimento")
            @Html.TextBoxFor(m => m.DataNascimento, "{0:yyyy-MM-dd}",
                new { @class = "form-control", type = "date", required = "required" })
        </div>

        <!-- Documento -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.TipoDocumento, "Tipo de Documento")
            @Html.TextBoxFor(m => m.TipoDocumento, new { @class = "form-control", placeholder = "BI" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.NumeroDocumento, "Número do Documento")
            @Html.TextBoxFor(m => m.NumeroDocumento, new { @class = "form-control", placeholder = "Número do documento" })
        </div>

        <!-- Contactos -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.Telefone, "Telefone")
            @Html.TextBoxFor(m => m.Telefone, new { @class = "form-control", placeholder = "923 xxx xxx" })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Email)
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "exemplo@email.com", type = "email" })
        </div>

        <!-- Género -->
        <div class="col-md-6">
            @Html.LabelFor(m => m.Genero, "Género")
            @Html.DropDownListFor(m => m.Genero,
                new SelectList(new[]
                {
                    new { Value = "", Text = "-- Selecione --" },
                    new { Value = "Masculino", Text = "Masculino" },
                    new { Value = "Feminino", Text = "Feminino" }
                }, "Value", "Text"),
                new { @class = "form-control" })
        </div>

    

    </div>

    <div class="mt-4 text-right">
        <a href="@Url.Action("Index", "Pacientes")" class="btn btn-warning">
            <i class="fa fa-times-circle"></i> Cancelar
        </a>
        <button type="submit" class="btn btn-primary ml-2">
            <i class="fa fa-save"></i> Salvar
        </button>
    </div>
}
