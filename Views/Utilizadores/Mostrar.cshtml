@model MGMC.Models.User

@{
    ViewBag.Title = "Detalhes do Utilizador";
}

<h4 class="text-center font-weight-bold mb-4">
    <i class="fa fa-user"></i> DETALHES DO UTILIZADOR
</h4>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body">

                <dl class="row">

                    <dt class="col-sm-4">Nome</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Tipo de Utilizador</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-info">
                            @Model.Perfil
                        </span>
                    </dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Ativo)
                        {
                            <span class="badge badge-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Inativo</span>
                        }
                    </dd>

                </dl>

                <div class="text-right">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Voltar
                    </a>

                    <a href="@Url.Action("Edit", new { id = Model.Id })"
                       class="btn btn-primary ml-2">
                        <i class="fa fa-edit"></i> Editar
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
