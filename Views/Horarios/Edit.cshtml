@model MGMC.Models.Horario

@{
    ViewBag.Title = "Editar Horário";
}

<h4 class="text-center font-weight-bold mb-4">
    <i class="fa fa-clock"></i> EDITAR HORÁRIO
</h4>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)

    <div class="row">

        <!-- Médico (bloqueado) -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label("Médico")
                <input type="text"
                       class="form-control"
                       value="@Model.Medico.Nome"
                       disabled />
                @Html.HiddenFor(m => m.MedicoId)
            </div>
        </div>

        <!-- Dia da Semana -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.DiaSemana, "Dia da Semana")
                @Html.EnumDropDownListFor(m => m.DiaSemana,
                    "-- Selecione --",
                    new { @class = "form-control", required = "required" })
            </div>
        </div>

        <!-- Hora Início -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.HoraInicio, "Hora de Início")
                @Html.TextBoxFor(m => m.HoraInicio,
                    new { @class = "form-control", type = "time", required = "required" })
            </div>
        </div>

        <!-- Hora Fim -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.HoraFim, "Hora de Fim")
                @Html.TextBoxFor(m => m.HoraFim,
                    new { @class = "form-control", type = "time", required = "required" })
            </div>
        </div>


    </div>

    <div class="mt-4 text-right">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Voltar
        </a>

        <button type="submit" class="btn btn-primary ml-2">
            <i class="fa fa-save"></i> Salvar Alterações
        </button>
    </div>
}
