@model IEnumerable<MGMC.Models.Horario>

@{
    ViewBag.Title = "Horários dos Médicos";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mx-2 mt-2">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <strong>Sucesso!</strong> @TempData["success"]
    </div>
}

<section class="content1">
    <h3 class="text-center font-weight-bold mb-4">
        HORÁRIOS DOS MÉDICOS
    </h3>

    <div class="row justify-content-center">
        <div class="col-md-11">
            <div class="card shadow">
                <div class="card-body">

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info text-center">
                            Nenhum horário registado.
                        </div>
                    }
                    else
                    {
                        <table class="table table-bordered table-hover text-center">
                            <thead class="thead-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Médico</th>
                                    <th>Dia</th>
                                    <th>Início</th>
                                    <th>Fim</th>
                                    <th>Opções</th>
                                </tr>
                            </thead>

                            <tbody>
                                @{
                                    int num = 1;
                                }

                                @foreach (var h in Model)
                                {
                                    <tr>
                                        <td>@num</td>
                                        <td>@h.Medico.Nome</td>
                                        <td>@h.DiaSemana</td>
                                        <td>@h.HoraInicio.ToString(@"hh\:mm")</td>
                                        <td>@h.HoraFim.ToString(@"hh\:mm")</td>


                                        <td>
                                            @using (Html.BeginForm("Delete", "Horarios",
                                                new { id = h.Id },
                                                FormMethod.Post,
                                                new
                                                {
                                                    style = "display:inline",
                                                    onsubmit = "return confirm('Deseja apagar este horário?');"
                                                }))
                                            {
                                                <button class="btn btn-danger btn-sm">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            }

                                    
                                        </td>
                                    </tr>
                                    num++;
                                }
                            </tbody>
                        </table>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .content1 {
        min-height: 250px;
        padding: 15px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 70px;
        padding-right: 15px;
    }
</style>
