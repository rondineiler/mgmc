@model MGMC.Models.Horario

@{
    ViewBag.Title = "Cadastro de Horário";
}

<h4 class="text-center mt-2 font-weight-bold">
    <i class="fa fa-clock"></i> CADASTRO DE HORÁRIO DO MÉDICO
</h4>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

@using (Html.BeginForm("Create", "Horarios", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="row">

        <!-- Médico -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.MedicoId, "Médico")
                @Html.DropDownListFor(m => m.MedicoId,
                    ViewBag.Medicos as SelectList,
                    "-- Selecione o Médico --",
                    new { @class = "form-control", required = "required" })
            </div>
        </div>

        <!-- Dia da Semana -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.DiaSemana, "Dia da Semana")
                @Html.EnumDropDownListFor(m => m.DiaSemana,
                    "-- Selecione --",
                    new { @class = "form-control", required = "required" })
            </div>
        </div>

        <!-- Hora Início -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.HoraInicio, "Hora de Início")
                @Html.TextBoxFor(m => m.HoraInicio,
                    new { @class = "form-control", type = "time", required = "required" })
            </div>
        </div>

        <!-- Hora Fim -->
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(m => m.HoraFim, "Hora de Fim")
                @Html.TextBoxFor(m => m.HoraFim,
                    new { @class = "form-control", type = "time", required = "required" })
            </div>
        </div>

    </div>

    <div class="mt-4 text-right">
        <a href="@Url.Action("Index", "Horarios")" class="btn btn-warning">
            <i class="fa fa-times-circle"></i> Cancelar
        </a>

        <button type="submit" class="btn btn-primary ml-2">
            <i class="fa fa-save"></i> Salvar
        </button>
    </div>
}
