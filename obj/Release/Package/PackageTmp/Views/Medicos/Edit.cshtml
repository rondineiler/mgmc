@model MGMC.Models.Medico

@{
    ViewBag.Title = "Editar Médico";
}

<h4 class="text-center font-weight-bold mb-4">
    <i class="fa fa-user-md"></i> EDITAR MÉDICO
</h4>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)

    <div class="row">

        <div class="col-md-6">
            @Html.LabelFor(m => m.Nome)
            @Html.TextBoxFor(m => m.Nome, new
            {
                @class = "form-control",
                required = "required"
            })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Especialidade)
            @Html.TextBoxFor(m => m.Especialidade, new
            {
                @class = "form-control",
                required = "required"
            })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Telefone)
            @Html.TextBoxFor(m => m.Telefone, new
            {
                @class = "form-control"
            })
        </div>

        <div class="col-md-6">
            @Html.LabelFor(m => m.Email)
            @Html.TextBoxFor(m => m.Email, new
            {
                @class = "form-control",
                type = "email",
                required = "required"
            })
        </div>


    </div>

    <div class="mt-4 text-right">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Voltar
        </a>

        <button type="submit" class="btn btn-primary ml-2">
            <i class="fa fa-save"></i> Salvar Alterações
        </button>
    </div>
}
