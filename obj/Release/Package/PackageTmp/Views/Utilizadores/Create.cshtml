@model MGMC.Models.User

@{
    ViewBag.Title = "Cadastrar Utilizador";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mx-2 mt-2">
        <strong>Sucesso!</strong> @TempData["success"]
        <button type="button" class="close" data-dismiss="alert">
            <span>&times;</span>
        </button>
    </div>
}

<section class="content-header text-center mb-4">
    <h4 class="font-weight-bold">
        <i class="fa fa-user-circle-o"></i>
        Cadastro de Utilizador
    </h4>
</section>

<section class="content1">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fa fa-user"></i> Dados do Utilizador
                    </h5>
                </div>

                <div class="card-body">

                    @using (Html.BeginForm("Create", "Utilizadores", FormMethod.Post,
                        new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">

                            <!-- Nome -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Nome Completo <code>*</code></label>
                                    @Html.TextBoxFor(m => m.Nome, new
                                    {
                                        @class = "form-control",
                                        placeholder = "Digite o nome completo",
                                        required = "required"
                                    })
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Email <code>*</code></label>
                                    @Html.TextBoxFor(m => m.Email, new
                                    {
                                        @class = "form-control",
                                        type = "email",
                                        placeholder = "exemplo@email.com",
                                        required = "required"
                                    })
                                </div>
                            </div>

                            <!-- Senha -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Senha <code>*</code></label>
                                    @Html.PasswordFor(m => m.Senha, new
                                    {
                                        @class = "form-control",
                                        placeholder = "Digite a senha",
                                        required = "required"
                                    })
                                </div>
                            </div>

                            <!-- Tipo de Utilizador -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tipo de Utilizador <code>*</code></label>
                                    @Html.DropDownListFor(m => m.Perfil,
                                        new SelectList(new[]
                                        {
                                            "Administrador",
                                            "Medico",
                                            "Recepcionista"
                                        }),
                                        "-- Selecione --",
                                        new { @class = "form-control", required = "required" })
                                </div>
                            </div>



                        </div>

                        <hr />

                        <div class="text-right">
                            <a href="@Url.Action("Index", "Utilizadores")"
                               class="btn btn-warning">
                                <i class="fa fa-times-circle"></i> Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary ml-2">
                                <i class="fa fa-save"></i> Salvar
                            </button>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</section>

<script>
    function previewFile() {
        const file = document.querySelector('input[type=file]').files[0];
        const preview = document.getElementById("previewImg");

        if (file) {
            const reader = new FileReader();
            reader.onload = () => preview.src = reader.result;
            reader.readAsDataURL(file);
        }
    }
</script>

<style>
    .content1 {
        min-height: 250px;
        padding: 20px 15px;
        padding-left: 70px;
    }
</style>
